# ==========================================
# SDAKW Frontend Environment Variables
# ==========================================

# 1. Target Backend API URL (Used by Next.js rewrites and SSR server-side calls)
# - In local development: http://localhost:5000/api/v1
# - In production (e.g. on Vercel): https://sdakw-website.onrender.com/api/v1
BACKEND_API_URL=http://localhost:5000/api/v1

# 2. Client-facing API URL (Used in the browser via Axios / apiClient)
# - Defaults to relative '/api/v1' so requests go through the Next.js Same-Origin reverse proxy.
# - This ensures First-Party Cookie compatibility on Safari/iOS (ITP compliance).
NEXT_PUBLIC_API_URL=/api/v1

# 3. Canonical App URL (Used for SEO and OpenGraph metadata generation)
NEXT_PUBLIC_APP_URL=https://sdakw.com